{
    "name": "atoolo/oparl-bundle",
    "description": "Indexes OParl data (meetings, papers, organizations, ...) into the search index",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "oparl",
        "indexer",
        "solr"
    ],
    "authors": [
        {
            "name": "Felix Becker",
            "email": "becker@sitepark.com"
        }
    ],
    "require": {
        "php": ">=8.1 <8.6.0",
        "atoolo/index-bundle": "^1",
        "atoolo/resource-bundle": "^1",
        "atoolo/search-bundle": "1.x-dev",
        "php-http/discovery": "^1.19",
        "psr/cache": "^2.0 || ^3.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-factory-implementation": "*",
        "psr/log": "^3",
        "sitepark/oparl-client": "^1.0",
        "solarium/solarium": "^6.4 || ^7.0",
        "symfony/cache": "^6.4 || ^7.4",
        "symfony/config": "^6.4 || ^7.4",
        "symfony/dependency-injection": "^6.4 || ^7.4",
        "symfony/http-client": "^6.4 || ^7.4",
        "symfony/http-kernel": "^6.4 || ^7.4",
        "symfony/lock": "^6.4 || ^7.4",
        "symfony/yaml": "^6.4 || ^7.4"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "infection/infection": "^0.27.11",
        "nyholm/psr7": "^1.8",
        "overtrue/phplint": "^9.6",
        "phpcompatibility/php-compatibility": "^9.3.5",
        "phpunit/phpunit": "^10.5.63",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^3.13.5",
        "symfony/framework-bundle": "^6.4 || ^7.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Atoolo\\Oparl\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atoolo\\Oparl\\Test\\": "test"
        }
    },
    "archive": {
        "exclude": [
            "*",
            "!composer.json",
            "!config",
            "!src"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true,
            "php-http/discovery": false
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "scripts": {
        "post-install-cmd": "phive --no-progress install --trust-gpg-keys C00543248C87FB13,4AA394086372C20A,CF1A108D0E7AE720,51C67305FFC2E5C0,E82B2FB314E9906E",
        "analyse": [
            "@analyse:phplint",
            "@analyse:phpstan",
            "@analyse:phpcsfixer",
            "@analyse:compatibilitycheck"
        ],
        "analyse:compatibilitycheck": "./vendor/bin/phpcs --standard=./phpcs.compatibilitycheck.xml",
        "analyse:phpcsfixer": "./tools/php-cs-fixer check --diff --show-progress=dots",
        "analyse:phplint": "./vendor/bin/phplint",
        "analyse:phpstan": "./tools/phpstan analyse",
        "fix": [
            "@fix:phpcsfixer"
        ],
        "fix:phpcsfixer": "./tools/php-cs-fixer fix",
        "report": [
            "@report:phpstan"
        ],
        "report:phpstan": "./tools/phpstan analyse --no-progress --no-ansi --no-interaction --error-format=checkstyle > ./var/log/phpstan-report.xml || exit 0",
        "test": [
            "@test:phpunit"
        ],
        "test:infection": "vendor/bin/infection --threads=8 --no-progress --only-covered -s || exit 0",
        "test:phpunit": "./tools/phpunit.phar -c phpunit.xml --coverage-text"
    }
}
